# ============================================================
# CleverFox — .gitignore
# ============================================================

# ─── Logs ───────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Node / Package managers ────────────────────────────────
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml
.pnp
.pnp.js

# ─── Environment & Secrets (NEVER commit real .env files) ───
.env
.env.*
!.env.example        # keep the example template
.envrc
.npmrc
.yarnrc
.yarnrc.yml

# Local env overrides
*.env.local
*.env.development
*.env.test
*.env.production

# ─── Python / Virtual env ───────────────────────────────────
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist-info/
*.egg
pip-log.txt

# ─── Build / Compiled output ────────────────────────────────
dist/
dist-ssr/
dist-react/
build/
out/
coverage/
.cache/
*.tsbuildinfo

# Electron specific build output
electron/dist/

# ─── TypeScript ─────────────────────────────────────────────
*.js.map
*.d.ts.map
tsconfig.tsbuildinfo

# ─── Local / Runtime app data ───────────────────────────────
# Electron stores user session, cache, IndexedDB here — never commit
cleverfox_data/

# ─── Database dumps / User data ─────────────────────────────
user_data.csv
*.csv
*.sqlite
*.db

# ─── Media assets (large binary files) ──────────────────────
musics/
*.mp3
*.mp4
*.wav
*.ogg
*.flac
client/public/background-images/

# ─── Executables ────────────────────────────────────────────
*.exe
*.dmg
*.AppImage
*.deb
*.rpm
*.snap
release/

# ─── Sensitive credential files ─────────────────────────────
*secrets*.json
*secret*.json
*credentials*.json
*creds*.json
*service-account*.json
*service_account*.json
**/*.local.json
*.pem
*.key
*.p12
*.pfx
*.crt
*.cert

# ─── Editor & OS junk ───────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.local
desktop.ini

# ─── Temp / Scratch files ───────────────────────────────────
temp.txt
*.tmp
*.bak
*.swp
*.orig
test.js

# ─── Report / Academic files (not part of deployable code) ──
report/
report_reference.txt
