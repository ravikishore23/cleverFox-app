# Client (Vite) env vars

# Spotify Developer Dashboard -> your app -> Client ID
# Create at: https://developer.spotify.com/dashboard
# For local dev, add Redirect URI: http://127.0.0.1:5173
VITE_SPOTIFY_CLIENT_ID=

# Optional: if you use the separate backend server
VITE_API_BASE_URL=http://127.0.0.1:3001
