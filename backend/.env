# Backend server
PORT=3001
# Vite dev server (if Vite picks a different port, CORS is still allowed for localhost/127.0.0.1 and LAN IPs)
FRONTEND_ORIGIN=http://127.0.0.1:5173

# MongoDB (local)
# Ensure MongoDB is running, then this should work:
#   mongodb://localhost:27017/cleverfox_db
MONGODB_URI=mongodb://localhost:27017/cleverfox_db

# AI / LLM Provider — always use Ollama
AI_PROVIDER=ollama

# Ollama API (cloud-hosted)
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_API_KEY=b282ac1356dd4210a28054a816ecf2b6.r6BMoWRWw-YucpsVIK8FlGhy

# Ollama model names (these are the values sent as `model` in API requests)
OLLAMA_MODEL_QWEN=qwen3.5:397b-cloud
OLLAMA_MODEL_GPT=gpt-oss:120b-cloud
OLLAMA_MODEL_DEEPSEEK=deepseek-v3.1:671b-cloud

# Default model
OLLAMA_MODEL=qwen3.5:397b-cloud







# Spotify (optional)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3001/auth/spotify/callback
