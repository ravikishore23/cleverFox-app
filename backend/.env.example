# Backend server
PORT=3001
FRONTEND_ORIGIN=http://127.0.0.1:5173

# AI / LLM
# Use `mock` to develop without keys.
AI_PROVIDER=mock
OPENAI_API_KEY=

# Spotify (only needed if backend will handle Spotify auth securely)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3001/auth/spotify/callback
