{
  "name": "cleverfox-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/dist/main.js",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"npm run dev:web\" \"npm --prefix backend run dev\"",
    "dev:web": "vite --config client/vite.config.ts --port 5173",
    "dev:client": "npm run dev:web",
    "dev:reset": "node scripts/kill-vite.mjs && node scripts/kill-port.mjs 5173 --force && vite --config client/vite.config.ts --port 5173 --strictPort --host",
    "dev:api": "npm --prefix backend run dev",
    "dev:all": "concurrently -n web,api -c cyan,magenta \"npm run dev:web\" \"npm --prefix backend run dev\"",
    "electron:build": "node scripts/build-electron.mjs",
    "electron:dev": "npm run electron:build && electron .",
    "dev:electron:attach": "npm run electron:dev",
    "dev:electron": "node scripts/dev-electron.mjs",
    "build": "npm run electron:build && tsc -b && vite build --config client/vite.config.ts",
    "lint": "eslint --config client/eslint.config.js client/src",
    "preview": "vite preview --config client/vite.config.ts"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.12.25",
    "@assistant-ui/react-markdown": "^0.12.9",
    "@boxicons/react": "^1.0.2",
    "@chakra-ui/react": "^3.32.0",
    "@chatscope/chat-ui-kit-react": "^2.1.1",
    "@chatscope/chat-ui-kit-styles": "^1.4.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mantine/core": "^8.3.14",
    "@mantine/dates": "^8.3.14",
    "@mantine/hooks": "^8.3.14",
    "@tabler/icons-react": "^3.36.1",
    "dayjs": "^1.11.19",
    "electron": "^40.2.1",
    "framer-motion": "^12.34.0",
    "jspdf": "^4.1.0",
    "marked": "^18.0.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "recharts": "^3.7.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@fontsource/fredoka": "^5.2.10",
    "@fontsource/inika": "^5.2.8",
    "@fontsource/mochiy-pop-one": "^5.2.8",
    "@fontsource/passero-one": "^5.2.8",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.9",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.1.0",
    "wait-on": "^8.0.5"
  }
}
